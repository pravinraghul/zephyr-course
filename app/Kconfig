menuconfig LED_SUBSYSTEM
    bool "Enable LED Subsystem"
    default y

choice
    prompt "LED blink sleep time"
    default LED_SLEEP_TIME_MS_750
    depends on LED_SUBSYSTEM

    config LED_SLEEP_TIME_MS_250
        bool "Fast (250ms)"

    config LED_SLEEP_TIME_MS_750
        bool "Medium (750ms)"

    config LED_SLEEP_TIME_MS_1500
        bool "Slow (1500ms)"
endchoice

config LED_SLEEP_TIME_MS
    int
    depends on LED_SUBSYSTEM
    default 250 if LED_SLEEP_TIME_MS_250
    default 750 if LED_SLEEP_TIME_MS_750
    default 1500 if LED_SLEEP_TIME_MS_1500
    default 0

menuconfig LED_ADVANCED_SETTINGS
    bool "Advanced LED settings"
    default y
    depends on LED_SUBSYSTEM

if LED_ADVANCED_SETTINGS
config LED_BRIGHTNESS
    int "LED brightness (0-100)"
    range 0 100
    default 100

config LED_FADE_DURATION_MS
    int "LED fade duration (ms)"
    default 500

menu "Expert settings"
    config LED_DEBUG
        bool "Enable LED debugging"

    config LED_CUSTOM_BLINK_PATTERN
        bool "Custom blink pattern"
endmenu
endif # LED_ADVANCED_SETTINGS

source "Kconfig.zephyr"